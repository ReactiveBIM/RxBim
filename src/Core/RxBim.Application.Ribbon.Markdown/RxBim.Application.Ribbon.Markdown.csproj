<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net8.0-windows</TargetFrameworks>
        <PlatformTarget>x64</PlatformTarget>
        <Configurations>Debug;Release</Configurations>
        <UseWpf>true</UseWpf>
        <Description>Optional Markdown rendering for interactive RxBim ribbon tooltips.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BimTeam.Markdig.Wpf" Version="1.4.2.1" />
        <ProjectReference Include="..\RxBim.Application.Ribbon\RxBim.Application.Ribbon.csproj" />
        <None Remove="README.md" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>